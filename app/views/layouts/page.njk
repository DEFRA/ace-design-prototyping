{#
  AICE Design Language — Base Page Layout

  Root template for all AICE-styled pages. All other layouts extend this.
  Provides: Defra header, service navigation, optional breadcrumb bar, footer.

  Usage:
    {% extends "layouts/page.njk" %}
    {% block content %}...{% endblock %}

  Expected template variables:
    serviceName  — e.g. "AICE Design Prototyping"
    serviceUrl   — href for the service name link; defaults to "/"
    pageTitle    — browser <title> prefix
    currentUrl   — current path; drives aria-current on nav items
    breadcrumbs  — array of { text, href }; renders the green breadcrumb bar when set
#}
{% extends "govuk-prototype-kit/layouts/govuk-branded.njk" %}

{# ──────────────────────────────────────────────────────────────────────────────
  <title>
────────────────────────────────────────────────────────────────────────────── #}
{% block pageTitle %}{{ pageTitle }} | {{ serviceName }}{% endblock %}

{# ──────────────────────────────────────────────────────────────────────────────
  HEADER
  White background. Three-column grid: logo | service name | (search placeholder).
  Service name colour: $defra-green-aa (#00a33b) — AA contrast on white.
────────────────────────────────────────────────────────────────────────────── #}
{% block header %}
<header class="defra-header" role="banner">
  <div class="defra-header__inner">

    {# Logo — decorative, alt="" and role="presentation" #}
    <a href="{{ serviceUrl | default('/') }}">
      <img
        src="/public/images/defra-logo.svg"
        alt=""
        role="presentation"
        class="defra-header__logo"
      >
    </a>

    {# Service name — $defra-green-aa (#00a33b), Arial 22px bold #}
    <a href="{{ serviceUrl | default('/') }}" class="defra-header__service-name">
      <span class="govuk-visually-hidden">Department for Environment, Food and Rural Affairs: </span>
      {{ serviceName }}
    </a>

  </div>
</header>

{# ── Service navigation ────────────────────────────────────────────────────────
  Full-width Defra green bar (#008531) directly below the header.
  White links. aria-current="page" marks the active section.
  Hamburger toggle revealed on mobile via JS.
────────────────────────────────────────────────────────────────────────────── #}
{% if not hideServiceNavigation %}
{% include "partials/service-navigation.njk" %}
{% endif %}

{% endblock %}

{# ──────────────────────────────────────────────────────────────────────────────
  MAIN BLOCK
  Renders the optional full-bleed green breadcrumb bar (content pages only)
  then the govuk-main-wrapper with the content block inside.

  Hub pages override this block entirely (see layouts/hub.njk) to omit
  the breadcrumb bar and set padding-top: 0 for the flush hero.
────────────────────────────────────────────────────────────────────────────── #}
{% block main %}

  {# Full-bleed green breadcrumb bar — not inside any width container #}
  {% if breadcrumbs and breadcrumbs.length %}
  <div class="defra-breadcrumb-bar">
    <div class="defra-width-container">
      <nav aria-label="Breadcrumb">
        {% for crumb in breadcrumbs %}
          {% if not loop.last %}
            <a class="defra-breadcrumb-bar__link" href="{{ crumb.href }}">{{ crumb.text }}</a>
            <span class="defra-breadcrumb-bar__separator" aria-hidden="true">/</span>
          {% else %}
            <span class="defra-breadcrumb-bar__current" aria-current="page">{{ crumb.text }}</span>
          {% endif %}
        {% endfor %}
      </nav>
    </div>
  </div>
  {% endif %}

  <main class="govuk-main-wrapper" id="main-content">
    {% block content %}{% endblock %}
  </main>

{% endblock %}

{# ──────────────────────────────────────────────────────────────────────────────
  FOOTER
────────────────────────────────────────────────────────────────────────────── #}
{% block footer %}
{% include "partials/footer.njk" %}
{% endblock %}
